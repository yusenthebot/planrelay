#!/bin/sh
set -eu
task_plugin_root=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
if ! command -v uv >/dev/null 2>&1; then
    echo "gpt-connector: install uv and ensure it is on the Codex host PATH" >&2
    exit 2
fi
exec uv run --isolated --directory "$task_plugin_root" --frozen --no-dev gpt-connector mcp
